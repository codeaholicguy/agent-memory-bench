{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-memory-bench.dev/schema/fixture-v1.json",
  "title": "Agent Memory Bench Fixture",
  "type": "object",
  "required": ["schemaVersion", "name", "memories", "cases"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "memories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "content"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 10, "maxLength": 100 },
          "content": { "type": "string", "minLength": 50, "maxLength": 5000 },
          "tags": { "type": "array", "items": { "type": "string" } },
          "scope": { "type": "string" }
        }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "need", "variant", "query", "judgments"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "need": { "type": "string", "minLength": 1 },
          "variant": { "enum": ["natural-language", "keyword", "paraphrase", "identifier-exact"] },
          "query": { "type": "string", "minLength": 1 },
          "scope": { "type": "string" },
          "contextTags": { "type": "array", "items": { "type": "string" } },
          "judgments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["memoryId", "relevance"],
              "properties": {
                "memoryId": { "type": "string" },
                "relevance": { "enum": [0, 1, 2] }
              }
            }
          }
        }
      }
    }
  }
}
